# Copy to .env and fill in the keys. Never commit .env.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
MONTAJ_DATA_DIR=data
MONTAJ_DEEPGRAM_LANGUAGE=en
MONTAJ_DEEPGRAM_MODEL=nova-3
MONTAJ_DEEPGRAM_DIARIZE=false
MONTAJ_CLAUDE_MODEL=claude-sonnet-5-5
MONTAJ_RANK_MODEL=claude-haiku-5-5
MONTAJ_MAX_COST_PER_RUN_USD=0.50
MONTAJ_MAX_COST_PER_SOURCE_USD=2.00
MONTAJ_MAX_SOURCE_MINUTES=120
MONTAJ_MAX_SOURCE_MB=1024
MONTAJ_BACKUP_KEEP=7
MONTAJ_MIN_FREE_MB=1024
MONTAJ_CLEAN_OLDER_THAN_DAYS=14
